{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    14
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "afterhours-workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 2
              },
              "min": 90,
              "content": {
                "mod": "afterhours-spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "afterhours-agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 69
          },
          "content": {
            "mod": "afterhours-workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ],
      "radius": 16,
      "border": {
        "width": 1,
        "color": "border"
      }
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 50
          },
          "window_drag": true,
          "content": {
            "mod": "afterhours-tabs"
          }
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": [
            0,
            0
          ],
          "gap": 8,
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 16,
                  "background": "background",
                  "lone": true,
                  "border": {
                    "width": 0,
                    "color": "border"
                  },
                  "focus": {
                    "width": 0,
                    "color": "input"
                  },
                  "header": {
                    "content": {
                      "mod": "afterhours-pane"
                    },
                    "height": 34,
                    "position": "top",
                    "reveal": "always"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "afterhours-files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ],
              "radius": 12,
              "border": {
                "width": 1,
                "color": "border"
              },
              "background": "surface"
            }
          ]
        },
        {
          "id": "status",
          "type": "block",
          "size": {
            "px": 28
          },
          "content": {
            "mod": "afterhours-workspace-status"
          }
        }
      ],
      "background": "#00000000"
    }
  ],
  "theme": {
    "light": "afterhours-light",
    "dark": "afterhours-dark"
  },
  "font": "Geist Mono",
  "ui_font": "Geist",
  "font_size": 13.5,
  "toast": "afterhours-toast",
  "cloned_from": {
    "name": "main",
    "version": "0.1.15"
  },
  "padding": 8,
  "gap": 8,
  "terminal_opacity": 0
}